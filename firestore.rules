rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ── loan_applications ─────────────────────────────────────────
    // Frontend query MUST include where('userId','==', uid) for collection reads
    // to satisfy this rule — see ApplicationContext.tsx.
    match /loan_applications/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow read, update: if isSignedIn()
                          && (isOwner(resource.data.userId)
                              || request.auth.token.admin == true);

      allow delete: if isSignedIn()
                    && request.auth.token.admin == true;
    }

    // ── applications ──────────────────────────────────────────────
    match /applications/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow read, update: if isSignedIn()
                          && (isOwner(resource.data.userId)
                              || request.auth.token.admin == true);

      allow delete: if isSignedIn()
                    && request.auth.token.admin == true;
    }

    // ── customers ─────────────────────────────────────────────────
    // Primary customer entity. Officers own their customer records.
    match /customers/{customerId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn()
                                  && isOwner(resource.data.userId);

      // Extracted document data per customer
      match /documents/{docId} {
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid;

        allow read, update, delete: if isSignedIn()
                                    && isOwner(resource.data.userId);
      }

      // CIBIL assessment history per customer
      match /cibilAssessments/{assessmentId} {
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid;

        allow read, update, delete: if isSignedIn()
                                    && isOwner(resource.data.userId);
      }
    }

    // ── extracted_documents ───────────────────────────────────────
    match /extracted_documents/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn()
                                  && isOwner(resource.data.userId);
    }

    // ── users ─────────────────────────────────────────────────────
    // Top-level user profile document.
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);

      // Per-user preferences (theme, notification toggles, etc.)
      match /preferences/{prefDoc} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }
  }
}
